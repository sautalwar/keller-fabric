// Keller Group — Row-Level Security (RLS) DAX Rules
// Generated by GitHub Copilot Agent Mode
//
// These DAX expressions filter data based on the signed-in user's
// region mapping from the EmployeeRegions table.
// Import these into your semantic model's security roles.

// ═══════════════════════════════════════════════════════════════
// ROLE: Regional Viewer
// Description: Users see only data for their assigned region
// ═══════════════════════════════════════════════════════════════

// Filter on FixedAssets table:
[Region] = LOOKUPVALUE(
    EmployeeRegions[Region],
    EmployeeRegions[Email],
    USERPRINCIPALNAME()
)

// Filter on RegionalBudgets table:
[Region] = LOOKUPVALUE(
    EmployeeRegions[Region],
    EmployeeRegions[Email],
    USERPRINCIPALNAME()
)


// ═══════════════════════════════════════════════════════════════
// ROLE: Regional Manager
// Description: Managers see their region + can see all departments
// Same filter as viewer, but with additional permissions in OLS
// ═══════════════════════════════════════════════════════════════

// Filter on FixedAssets table:
[Region] = LOOKUPVALUE(
    EmployeeRegions[Region],
    EmployeeRegions[Email],
    USERPRINCIPALNAME()
)

// Filter on RegionalBudgets table (managers see all departments):
[Region] = LOOKUPVALUE(
    EmployeeRegions[Region],
    EmployeeRegions[Email],
    USERPRINCIPALNAME()
)


// ═══════════════════════════════════════════════════════════════
// ROLE: Global Admin
// Description: BI team leads see all data across all regions
// No filter expression = full access
// ═══════════════════════════════════════════════════════════════

// (No DAX filter — this role has unrestricted access)


