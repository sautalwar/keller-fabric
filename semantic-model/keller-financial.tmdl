// Keller Group Financial Semantic Model — TMDL Definition
// Generated by GitHub Copilot Agent Mode
//
// This is a simplified TMDL representation of the Keller Group
// financial semantic model for demo purposes.

model Keller_Financial

  // ── Data Sources ──
  // DirectLake connection to OneLake lakehouse
  expression LakehouseConnection =
    let
      Source = Sql.Database("YOUR-LAKEHOUSE-ENDPOINT", "YOUR-LAKEHOUSE-DB")
    in
      Source

  // ── Tables ──

  table FixedAssets
    lineageTag: "fa-001"
    column AssetId
      dataType: string
      isKey: true
    column AssetName
      dataType: string
    column Category
      dataType: string
    column Region
      dataType: string
    column Country
      dataType: string
    column AcquisitionDate
      dataType: dateTime
      formatString: "yyyy-MM-dd"
    column AcquisitionCost
      dataType: decimal
      formatString: "#,##0.00"
    column NetBookValue
      dataType: decimal
      formatString: "#,##0.00"
    column AnnualDepreciation
      dataType: decimal
      formatString: "#,##0.00"
    column AccumulatedDepreciation
      dataType: decimal
      formatString: "#,##0.00"
    column Status
      dataType: string
    column AgeYears
      dataType: double
      formatString: "0.0"

    partition FixedAssets = entity
      entityName: "silver_fixed_assets"

  table RegionalBudgets
    lineageTag: "rb-001"
    column BudgetId
      dataType: string
      isKey: true
    column Region
      dataType: string
    column Department
      dataType: string
    column FiscalYear
      dataType: int64
    column Quarter
      dataType: string
    column BudgetAmount
      dataType: decimal
      formatString: "#,##0.00"
    column ActualAmount
      dataType: decimal
      formatString: "#,##0.00"
    column ForecastAmount
      dataType: decimal
      formatString: "#,##0.00"
    column Variance
      dataType: decimal
      formatString: "#,##0.00"
    column VariancePct
      dataType: double
      formatString: "0.0%"
    column Status
      dataType: string
    column Currency
      dataType: string

    partition RegionalBudgets = entity
      entityName: "silver_regional_budgets"

  table EmployeeRegions
    lineageTag: "er-001"
    isHidden: true  // Security table — hidden from report users
    column EmployeeId
      dataType: string
      isKey: true
    column Email
      dataType: string
    column Region
      dataType: string
    column IsManager
      dataType: boolean

    partition EmployeeRegions = entity
      entityName: "silver_employee_regions"

  // ── Relationships ──

  relationship RegionBridge
    fromColumn: FixedAssets.Region
    toColumn: RegionalBudgets.Region
    crossFilteringBehavior: bothDirections

  relationship SecurityBridge
    fromColumn: EmployeeRegions.Region
    toColumn: FixedAssets.Region
    crossFilteringBehavior: bothDirections
    securityFilteringBehavior: bothDirections

  // ── Measures ──

  table Measures
    lineageTag: "m-001"

    measure 'Total Acquisition Cost' =
      SUM(FixedAssets[AcquisitionCost])
      formatString: "#,##0"

    measure 'Total Net Book Value' =
      SUM(FixedAssets[NetBookValue])
      formatString: "#,##0"

    measure 'Total Depreciation' =
      SUM(FixedAssets[AccumulatedDepreciation])
      formatString: "#,##0"

    measure 'Asset Count' =
      COUNTROWS(FixedAssets)
      formatString: "#,##0"

    measure 'Avg Asset Age' =
      AVERAGE(FixedAssets[AgeYears])
      formatString: "0.0"

    measure 'Budget Total' =
      SUM(RegionalBudgets[BudgetAmount])
      formatString: "#,##0"

    measure 'Actuals Total' =
      SUM(RegionalBudgets[ActualAmount])
      formatString: "#,##0"

    measure 'Budget Variance' =
      [Actuals Total] - [Budget Total]
      formatString: "+#,##0;-#,##0;0"

    measure 'Budget Variance %' =
      DIVIDE([Budget Variance], [Budget Total], 0)
      formatString: "+0.0%;-0.0%;0.0%"

    measure 'YoY Growth %' =
      VAR CurrentYear = SUM(RegionalBudgets[ActualAmount])
      VAR PreviousYear = CALCULATE(
        SUM(RegionalBudgets[ActualAmount]),
        SAMEPERIODLASTYEAR(RegionalBudgets[FiscalYear])
      )
      RETURN DIVIDE(CurrentYear - PreviousYear, PreviousYear, 0)
      formatString: "+0.0%;-0.0%;0.0%"

  // ── Row-Level Security ──
  // See security/rls-rules.dax for full definitions

  role 'Regional Viewer'
    modelPermission: read
    tablePermission FixedAssets =
      [Region] = LOOKUPVALUE(
        EmployeeRegions[Region],
        EmployeeRegions[Email],
        USERPRINCIPALNAME()
      )

  role 'Regional Manager'
    modelPermission: read
    tablePermission FixedAssets =
      [Region] = LOOKUPVALUE(
        EmployeeRegions[Region],
        EmployeeRegions[Email],
        USERPRINCIPALNAME()
      )
    tablePermission RegionalBudgets =
      [Region] = LOOKUPVALUE(
        EmployeeRegions[Region],
        EmployeeRegions[Email],
        USERPRINCIPALNAME()
      )
